# SPDX-License-Identifier: GPL-2.0-only

# NOTA: No agregues archivos generados en subdirectorios aquí.
# Usa el archivo ".gitignore" en esos subdirectorios para reglas específicas.

# Archivos ocultos básicos que SÍ deben permitirse:
!.gitignore
!.gitattributes
!.mailmap
!.clang-format
!.cocciconfig
!.get_maintainer.ignore

# Asegura que la carpeta .github y sus archivos de configuración NO se ignoren
!.github/
# (así puedes tener .github/copilot-instructions.md y más configuraciones)

# Objetos y binarios
*.a
*.bin
*.o
*.so
*.ko
*.elf
*.mod
*.patch
*.dtb
*.dtb.S
*.dwo
*.gz
*.bz2
*.lz4
*.lzma
*.lzo
*.xz
*.zst
*.orig
*.su

# Archivos de compilación y dependencias
*.c.[012]*.*
*.gcno
*.symtypes
*.symversions
*.patch
*.lex.c
*.ll
*.lst
*.mod.c
*.o.*
*.tab.[ch]
*.tar

# Otros generados
/tags
/TAGS
/linux
/modules-only.symvers
/vmlinux*
/System.map
/Module.markers
/modules.builtin*
/modules.nsdeps
/*.spec
/debian/
/snap/
/tar-install/
/include/config/
/include/generated/
/include/ksym/
/arch/*/include/generated/
patches-*
patches
series
cscope.*
ncscope.*
GPATH
GRTAGS
GSYMS
GTAGS
ID
extra_certificates
signing_key.pem
signing_key.priv
signing_key.x509
x509.genkey

# Kconfig presets y outputs
/all.config
/alldef.config
/allmod.config
/allno.config
/allrandom.config
/allyes.config
/defconfig

# Kdevelop4 files, Clang DB, Sphinx, etc
*.kdev4
/compile_commands.json
sphinx_*/

# Archivos y logs que has agregado tú
Guia de solucion de errores
build.log
.vscode/
drivers/kernelsu/userspace/ksud/.cargo/
# Ignora carpetas .github en subcarpetas
drivers/*/.github/
dtbo.img
motorola-kernel-modules/
Analisis/
