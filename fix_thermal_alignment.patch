+int __attribute__((weak)) cpuhvfs_pre_module_init(void) { return 0; }
+int __attribute__((weak)) cpuhvfs_module_init(void) { return 0; }
+
+/* mml / GPU placeholders */
+int __attribute__((weak)) mml_drm_query_cap(void *a, void *b) { return 0; }
+int __attribute__((weak)) mml_drm_submit(void *a, void *b) { return 0; }
+int __attribute__((weak)) mml_drm_racing_stop_sync(void) { return 0; }
