+int __attribute__((weak)) get_pwr_stat_check_map(void) { return 0; }
+int __attribute__((weak)) mcdi_get_mcdi_idle_state(void) { return 0; }
+
+/* idle / mcdi helpers */
+int __attribute__((weak)) mtk_idle_select(int arg) { return 0; }
+int __weak mtk_get_gpu_loading(unsigned int *loading)
+{
+	if (loading)
+		*loading = 0;
+	return 0;
+}
+
+/* turbo and other flags */
+int __attribute__((weak)) turbo_flag = 0;
+
+/* miscellaneous stubs */
+int __attribute__((weak)) get_immediate_cpuL_wrap(void) { return 0; }
+int __attribute__((weak)) get_immediate_cpuB_wrap(void) { return 0; }
+int __attribute__((weak)) get_immediate_gpu_wrap(void) { return 0; }
