+
+int __weak mtk_thermal_get_temp(enum mtk_thermal_sensor_id id)
+{
+	return 0;
+}
+
+struct proc_dir_entry *__weak mtk_thermal_get_proc_drv_therm_dir_entry(void)
+{
+	return NULL;
+}
+
+/* Additional stubs */
+int __attribute__((weak)) tscpu_get_temperature_range(void) { return 0; }
+int __attribute__((weak)) tscpu_get_curr_temp(void) { return 0; }
+int __attribute__((weak)) tscpu_curr_cpu_temp = 0;
+int __attribute__((weak)) tscpu_curr_gpu_temp = 0;
+int __attribute__((weak)) tscpu_get_curr_max_ts_temp(void) { return 0; }
+int __attribute__((weak)) tscpu_cur_fp_factor = 0;
+
+int (*__weak __aligned(8) get_immediate_tsX[8])(void) = { 0 };
