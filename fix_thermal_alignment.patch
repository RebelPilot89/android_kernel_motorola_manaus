+int __attribute__((weak)) get_immediate_ts2_wrap(void) { return 0; }
+int __attribute__((weak)) get_immediate_ts3_wrap(void) { return 0; }
+int __attribute__((weak)) get_immediate_ts4_wrap(void) { return 0; }
+int __attribute__((weak)) get_immediate_ts5_wrap(void) { return 0; }
