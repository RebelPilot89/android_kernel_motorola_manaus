config MTK_CAMERA_DPE_ISP7S
	tristate "[DPE] Depth Engine for ISP7S"
	depends on MTK_CAMERA_ISP_SUPPORT
	help
	  Depth Processing Engine for ISP7S (MT6879/Dimensity 7030).
	  Enable to calculate depth information between stereo camera images.
	  Disable if not supported or not wanted.

