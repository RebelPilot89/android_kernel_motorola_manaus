ccflags-y += -Wall -I$(srctree)/kernel/sched
ccflags-y += -I$(srctree)/drivers/misc/motorola/moto_sched

obj-$(CONFIG_MOTO_SCHED) += moto_sched.o

moto_sched-y := msched_main.o msched_sysfs.o msched_common.o

