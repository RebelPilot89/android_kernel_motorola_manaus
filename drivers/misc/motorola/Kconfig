	tristate "Semtech SX9325 SAR sensor support"
	depends on I2C

config MOTO_SX933X
	tristate "Semtech SX933X SAR sensor support"
	depends on I2C

config MOTO_SIGPRINT
	tristate "Motorola Signature Print support"

config MOTO_TPS61280
	tristate "TI TPS61280 Boost converter support"
	depends on I2C

config INPUT_DRV2624_MMI
	tristate "Motorola DRV2624 haptic support"
	depends on I2C
