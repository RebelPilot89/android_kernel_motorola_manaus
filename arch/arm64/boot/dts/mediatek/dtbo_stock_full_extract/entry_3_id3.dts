				compatible = "awinic,aw882xx_smartpa";
				#sound-dai-cells = <0x00>;
				reg = <0x35>;
				irq-gpio = <&pio>, <0x3e 0x00>;
				rcv-gpio = <&pio>, <0xa2 0x00>;
				sound-channel = <0x00>;
				vcalb_half = "true";
				status = "okay";
				phandle = <0x42>;
			};

			aw882xx_smartpa_0: aw882xx@34 {
				compatible = "awinic,aw882xx_smartpa";
				#sound-dai-cells = <0x00>;
				reg = <0x34>;
				irq-gpio = <&pio>, <0x04 0x00>;
				sound-channel = <0x01>;
				vcalb_half = "true";
				status = "okay";
				phandle = <0x43>;
			};

			fsa4480_switch: fsa4480@42 {
				compatible = "fsa,fsa4480-i2c";
				reg = <0x42>;
				phandle = <0x84>;
			};
		};
	};

	fragment@42 {
		target = <&sound>;

		__overlay__ {
			mediatek,spk-i2s = <0x01 0x0b>;

			mediatek,speaker-codec {
				sound-dai = <&aw882xx_smartpa_1>, <&aw882xx_smartpa_0>;
			};
		};
	};

	fragment@43 {
		target = <&regulator_vibrator>;

		__overlay__ {
			status = "ok";
			min-volt = <0x2932e0>;
			max-volt = <0x2932e0>;
		};
	};

	fragment@44 {
		target = <&clock_buffer_ctrl>;

		__overlay__ {
			mediatek,xo-bbck4 = <0x01>;
		};
	};

	fragment@45 {
		target = <&i2c3>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;

			nfc_pn5xx: nfc_pn5xx@28 {
				compatible = "qcom,sn-nci";
				reg = <0x28>;
				interrupt-parent = <&pio>;
				interrupts = <0x13 0x04 0x01 0x00>;
				qcom,sn-irq = <&pio>, <0x13 0x00>;
				qcom,sn-ven = <&pio>, <0x0d 0x00>;
				status = "okay";
				phandle = <0x85>;
			};
		};
	};

	fragment@46 {
		target = <&spi5>;

		__overlay__ {

			p61: p61@0 {
				compatible = "nxp,p61";
				reg = <0x00>;
				spi-max-frequency = <0x1312d00>;
				nxp,nfcc = "3-0028";
				pinctrl-names = "pinctrl_state_mode_spi", "pinctrl_state_mode_idle";
				pinctrl-0 = <&pinctrl_state_mode_spi>;
				pinctrl-1 = <&pinctrl_state_mode_idle>;
				status = "okay";
				phandle = <0x86>;
			};
		};
	};

	fragment@47 {
		target = <&pio>;

		__overlay__ {

			pinctrl_state_mode_spi: pinctrl_state_mode_spi {
				phandle = <0x44>;

				pins_cmd_dat {
					pinmux = <0x4f01 0x5001 0x5101 0x5201>;
					drive-strength = <0x02>;
				};
			};

			pinctrl_state_mode_idle: pinctrl_state_mode_idle {
				phandle = <0x45>;

				pins_cmd_dat {
					pinmux = <0x5000>;
					slew-rate = <0x01>;
					output-high;
				};
			};
		};
	};

	fragment@48 {
		target = <&spi1>;

		__overlay__ {
			status = "okay";
			tee-only;
			mediatek,pad-select = <0x00 0x01>;

			fingerprint@0 {
				compatible = "mediatek,fingerprint";
				reg = <0x00>;
				spi-max-frequency = <0x7a1200>;
				status = "okay";
			};

			goodix_tee@0 {
				status = "okay";
				compatible = "goodix,goodix-fp";
				reg = <0x01>;
				spi-max-frequency = <0x7a1200>;
				netlink-event = <0x1e>;
			};
		};
	};

	fragment@49 {
		target = <&soc>;

		__overlay__ {

			fp_egistec {
				compatible = "fp-egistec";
				interrupt-parent = <&pio>;
				interrupts = <0x18 0x01 0x18 0x00>;
				fp-ctrl-power;
				egistec,gpio_reset = <&pio>, <0x07 0x00>;
				egistec,gpio_irq = <&pio>, <0x18 0x00>;
				vcc_fp-supply = <&mt6368_vfp>;
				egis-fp,vcc-voltage = <0x325aa0 0x325aa0>;
				egis-fp,vcc-current = <0x186a0>;
				pinctrl-names = "egis_rst_high", "egis_rst_low", "egis_irq_active", "egis_spi_active", "egis_spi_default";
				pinctrl-0 = <&fingerfp_rst_high>;
				pinctrl-1 = <&fingerfp_rst_low>;
				pinctrl-2 = <&fingerfp_irq_active>;
				pinctrl-3 = <&fingerfp_spi_active>;
				pinctrl-4 = <&fingerfp_spi_default>;
				status = "okay";
			};

			goodix_fp: goodix_fp {
				compatible = "mediatek,fingerprint-goodix";
				interrupt-parent = <&pio>;
				interrupts = <0x18 0x01 0x18 0x00>;
				rgltr-ctrl-support;
				fp,vdd-supply = <&mt6368_vfp>;
				fp,voltage-range = <0x325aa0 0x325aa0>;
				pinctrl-names = "fingerprint_irq", "fingerprint_reset_high", "fingerprint_reset_low";
				pinctrl-0 = <&fingerfp_irq_active>;
				pinctrl-1 = <&fingerfp_rst_high>;
				pinctrl-2 = <&fingerfp_rst_low>;
				int-gpios = <&pio>, <0x18 0x00>;
				status = "okay";
				phandle = <0x87>;
			};

			charge_led {
				label = "red";
				led_mode = <0x02>;
				gpio_config = <0xa3>;
			};
		};
	};

