/dts-v1/;
/plugin/;

/ {

	fragment@channel-id {
		target-path = "/";

		__overlay__ {
			channel-id-map = "acg", "amxbr", "amxpr", "amxmx", "amxcl", "amxar", "amxla", "amxpe", "amxco", "tefbr", "tefmx", "tefar", "tefcl", "tefpe", "tefco", "perar", "entcl", "iusmx", "niibr", "niicl", "niimx", "niipe", "oibr", "timbr", "tigco", "retbr", "retar", "retla", "retcl", "tefla", "retla1st", "tefunl", "tigca", "tigca1st", "retmx", "attmx", "womcl", "avaco", "retpe", "openla", "opencl", "openmx", "altmx", "openpe", "openpub", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "reteu", "retgb", "retfr", "retes", "retie", "retde", "vfgb", "vfde", "vffr", "o2gb", "o2de", "orafr", "bouyfr", "eegb", "tescogb", "yoigo", "oraes", "retapac", "retmea", "vfit", "vfes", "vfeu", "3gb", "tescoie", "altfr", "3ie", "altpt", "timit", "retma", "windit", "vfhu", "vfro", "telhu", "playpl", "oraeu", "dteu", "teleu", "pluspl", "dtpl", "tefes", "altice", "vipeu", "veoneu", "openeu", "reteu2", "demogb", "retdemo", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "retca", "bwaca", "tkpca", "vzw", "att", "tmo", "sprint", "repw", "attpre", "cricket", "cc", "usc", "tracfone", "retus", "metropcs", "rcica", "wndca", "dmc", "bby", "amz", "acg", "lra", "comcast", "fi", "vzwpre", "boost", "spectrum", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "retin", "retcn", "telstra", "vfau", "amzin", "jioin", "airin", "retid", "cmcc", "ctcn", "cucn", "retmm", "gt4gtw", "retth", "retru", "trueth", "smarthk", "mobilpk", "retsea", "retjp", "softbank", "optus", "retkr", "retjio", "ymobile", "lguplus", "docomo", "retanz", "cbncn", "kddi", "rakuten", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined";
		};
	};

	fragment@0 {
		target = <&utags>;

		__overlay__ {
			compatible = "mmi,utags";
			mmi,main-utags = "/dev/block/by-name/utags";
			mmi,backup-utags = "/dev/block/by-name/utagsBackup";
		};
	};

	fragment@1 {
		target = <&hw>;

		__overlay__ {
			compatible = "mmi,utags";
			mmi,dir-name = "hw";
			mmi,main-utags = "/dev/block/by-name/hw";
		};
	};

	fragment@2 {
		target = <&chosen>;

		__overlay__ {
			bootargs_ext = "console=tty0 root=/dev/ram \tloglevel=8 \tandroidboot.hardware=mt6879 \tinitcall_debug=1";
		};
	};

	fragment@3 {
		target = <&mtk_leds>;

		__overlay__ {
			compatible = "mediatek,i2c-leds";

			backlight {
				led_mode = <0x06>;
				gate_enable = <0x01>;
				pwm_config = <0x00 0x01 0x00 0x00 0x00>;
			};
		};
	};

	fragment@4 {
		target = <&odm>;

		__overlay__ {

			vibrator0: vibrator@0 {
				compatible = "mediatek,vibrator";
				vib_timer = <0x19>;
				vib_limit = <0x09>;
				vib_vol = <0x09>;
				status = "disabled";
				phandle = <0x7a>;
			};
		};
	};

	fragment@5 {
		target = <&pio>;

		__overlay__ {

			gps_pins_default: gps_default {
				phandle = <0x01>;
			};

			gps_l1_lna_pins_ol: gps_l1_lna@0 {
				phandle = <0x02>;

				pins_cmd_dat {
					pinmux = <0x1700>;
					output-low;
				};
			};

			gps_l1_lna_pins_dsp_ctrl: gps_l1_lna@1 {
				phandle = <0x03>;

				pins_cmd_dat {
					pinmux = <0x1701>;
				};
			};

			gps_l1_lna_pins_oh: gps_l1_lna@2 {
				phandle = <0x04>;

				pins_cmd_dat {
					pinmux = <0x1700>;
					output-high;
				};
			};

			gps_l5_lna_pins_ol: gps_l5_lna@0 {
				phandle = <0x05>;

				pins_cmd_dat {
					pinmux = <0x1a00>;
					output-low;
				};
			};

			gps_l5_lna_pins_dsp_ctrl: gps_l5_lna@1 {
				phandle = <0x06>;

				pins_cmd_dat {
					pinmux = <0x1a04>;
				};
			};

			gps_l5_lna_pins_oh: gps_l5_lna@2 {
				phandle = <0x07>;

				pins_cmd_dat {
					pinmux = <0x1a00>;
					output-high;
				};
			};
		};
	};

	fragment@6 {
		target = <&gps>;

		__overlay__ {
			pinctrl-names = "default", "gps_l1_lna_disable", "gps_l1_lna_dsp_ctrl", "gps_l1_lna_enable", "gps_l5_lna_disable", "gps_l5_lna_dsp_ctrl", "gps_l5_lna_enable";
			pinctrl-0 = <&gps_pins_default>;
			pinctrl-1 = <&gps_l1_lna_pins_ol>;
			pinctrl-2 = <&gps_l1_lna_pins_dsp_ctrl>;
			pinctrl-3 = <&gps_l1_lna_pins_oh>;
			pinctrl-4 = <&gps_l5_lna_pins_ol>;
			pinctrl-5 = <&gps_l5_lna_pins_dsp_ctrl>;
			pinctrl-6 = <&gps_l5_lna_pins_oh>;
			status = "okay";
		};
	};

	fragment@7 {
		target = <&pio>;

		__overlay__ {

			sel_up: sel_high {
				phandle = <0x0a>;

				pins_cmd_dat {
					pinmux = <0x3c00>;
					output-high;
				};
			};

			sel_down: sel_low {
				phandle = <0x0b>;

				pins_cmd_dat {
					pinmux = <0x3c00>;
					output-low;
				};
			};

			sw_enable: sw_enable {
				phandle = <0x0c>;

				pins_cmd_dat {
					pinmux = <0x3b00>;
					output-low;
				};
			};

			sw_disable: sw_disable {
				phandle = <0x0d>;

				pins_cmd_dat {
					pinmux = <0x3b00>;
					output-low;
				};
			};

			ps_enable: ps_enable {
				phandle = <0x08>;

				pins_cmd_dat {
					pinmux = <0x8800>;
					output-high;
				};
			};

			ps_disable: ps_disable {
				phandle = <0x09>;

				pins_cmd_dat {
					pinmux = <0x8800>;
					output-low;
				};
			};
		};
	};

	fragment@8 {
		target = <&ps5169>;

		__overlay__ {
			pinctrl-names = "enable", "disable";
			pinctrl-0 = <&ps_enable>;
			pinctrl-1 = <&ps_disable>;
			status = "okay";
		};
	};

	fragment@9 {
		target = <&fusb304>;

		__overlay__ {
			pinctrl-names = "sel_up", "sel_down", "enable", "disable";
			pinctrl-0 = <&sel_up>;
			pinctrl-1 = <&sel_down>;
			pinctrl-2 = <&sw_enable>;
			pinctrl-3 = <&sw_disable>;
			status = "okay";
		};
	};

	fragment@10 {
		target = <&mt6375_typec>;

		__overlay__ {

			port {

				tcpc_typec_usb: endpoint@0 {
					remote-endpoint = <&ssusb_mux>;
					phandle = <0x0f>;
				};
			};
		};
	};

	fragment@11 {
		target = <&typec_mux_switch>;

		__overlay__ {
			orientation-switch;
			mode-switch;
			accessory;

			port {

				ssusb_mux: endpoint@0 {
					remote-endpoint = <&tcpc_typec_usb>;
					phandle = <0x0e>;
				};
			};
		};
	};

	fragment@12 {
		target = <&pio>;

		__overlay__ {

			mtkfb_pins_lcm_led_en1: lcm_led_en1_gpio {
				phandle = <0x10>;

				pins_cmd_dat {
					pinmux = <0xa300>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcm_led_en0: lcm_led_en0_gpio {
				phandle = <0x11>;

				pins_cmd_dat {
					pinmux = <0xa300>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcm_rst_out1_gpio: lcm_rst_out1_gpio {
				phandle = <0x12>;

				pins_cmd_dat {
					pinmux = <0x6100>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcm_rst_out0_gpio: lcm_rst_out0_gpio {
				phandle = <0x13>;

				pins_cmd_dat {
					pinmux = <0x6100>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcm_dsi_te: lcm_dsi_te {
				phandle = <0x14>;

				pins_cmd_dat {
					pinmux = <0x6001>;
				};
			};
		};
	};

	fragment@13 {
		target = <&mtkfb>;

		__overlay__ {
			pinctrl-names = "lcm_led_en1_gpio", "lcm_led_en0_gpio", "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te";
			pinctrl-0 = <&mtkfb_pins_lcm_led_en1>;
			pinctrl-1 = <&mtkfb_pins_lcm_led_en0>;
			pinctrl-2 = <&mtkfb_pins_lcm_rst_out1_gpio>;
			pinctrl-3 = <&mtkfb_pins_lcm_rst_out0_gpio>;
			pinctrl-4 = <&mtkfb_pins_lcm_dsi_te>;
			status = "okay";
		};
	};

	fragment@14 {
		target = <&dispsys_config>;

		__overlay__ {
			pinctrl-names = "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te";
			pinctrl-0 = <&mtkfb_pins_lcm_rst_out1_gpio>;
			pinctrl-1 = <&mtkfb_pins_lcm_rst_out0_gpio>;
			pinctrl-2 = <&mtkfb_pins_lcm_dsi_te>;
			status = "okay";
		};
	};

	fragment@15 {
		target = <&dsi0>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			panel1: panel1@0 {
				compatible = "jdi,nt36672e,vdo,120hz,hfp";
				reg = <0x00>;
				pm-enable-gpios = <&pio>, <0xa3 0x00>;
				reset-gpios = <&pio>, <0x61 0x00>;
				gate-ic = <0x12df>;
				pinctrl-names = "default";
				phandle = <0x7b>;
			};

			ports {

				port {

					dsi_out: endpoint {
						remote-endpoint = <&panel_in1>;
						phandle = <0x3d>;
					};
				};
			};
		};
	};

	fragment@16 {
		target = <&connfem>;

		__overlay__ {

			epa_elna_mtk {
				parts = <&nofem>, <&nofem>, <&qm42195>, <&qm45197>, <&nofem>, <&wlan3002c_laa>, <&qm42195>, <&qm45197_laa>, <&qm42195>, <&qm45197>, <&qm42195>, <&qm45197>, <&qm42195>, <&qm45197>, <&wlan7207h>, <&wlan7205c>, <&wlan7207h>, <&wlan7205c>;

				hwid {
					gpio = <&pio>, <0x7d 0x00>;

					pmic {
						channel_name = "pmic_vin1";
						range-0 = <0x140>;
					};
				};

				wifi {

					flags-2 {
						laa;
					};

					flags-3 {
						laa;
					};

					flags-4 {
						open-loop;
					};

					flags-6 {
						open-loop;
					};

					flags-8 {
						open-loop;
					};
				};

				bt {

					flags-1 {
						epa_elna;
					};

					flags-3 {
						epa_elna;
					};

					flags-4 {
						epa_elna;
					};

					flags-5 {
						bypass;
					};

					flags-6 {
						bypass;
					};

					flags-7 {
						epa_elna;
					};

					flags-8 {
						epa_elna;
					};
				};
			};
		};
	};

	fragment@17 {
		target = <&i2c6>;

		__overlay__ {

			spk: speaker_amp@5c {
				compatible = "richtek,rt5512";
				#sound-dai-cells = <0x00>;
				reg = <0x5c>;
				status = "disabled";
				sound-name-prefix = "Left";
				phandle = <0x16>;
			};
		};
	};

	fragment@18 {
		target = <&sound>;

		__overlay__ {
			mediatek,spk-i2s = <0x01 0x02>;

			mediatek,speaker-codec {
				sound-dai = <&spk>;
			};
		};
	};

	fragment@19 {
		target = <&afe>;

		__overlay__ {
			pinctrl-names = "aud_clk_mosi_off", "aud_clk_mosi_on", "aud_dat_mosi_off", "aud_dat_mosi_on", "aud_dat_mosi_ch34_off", "aud_dat_mosi_ch34_on", "aud_dat_miso0_off", "aud_dat_miso0_on", "aud_dat_miso1_off", "aud_dat_miso1_on", "aud_dat_miso2_off", "aud_dat_miso2_on", "vow_dat_miso_off", "vow_dat_miso_on", "vow_clk_miso_off", "vow_clk_miso_on", "aud_gpio_i2s2_off", "aud_gpio_i2s2_on", "aud_gpio_i2s1_off", "aud_gpio_i2s1_on";
			pinctrl-0 = <&aud_clk_mosi_off>;
			pinctrl-1 = <&aud_clk_mosi_on>;
			pinctrl-2 = <&aud_dat_mosi_off>;
			pinctrl-3 = <&aud_dat_mosi_on>;
			pinctrl-4 = <&aud_dat_mosi_ch34_off>;
			pinctrl-5 = <&aud_dat_mosi_ch34_on>;
			pinctrl-6 = <&aud_dat_miso0_off>;
			pinctrl-7 = <&aud_dat_miso0_on>;
			pinctrl-8 = <&aud_dat_miso1_off>;
			pinctrl-9 = <&aud_dat_miso1_on>;
			pinctrl-10 = <&aud_dat_miso2_off>;
			pinctrl-11 = <&aud_dat_miso2_on>;
			pinctrl-12 = <&vow_dat_miso_off>;
			pinctrl-13 = <&vow_dat_miso_on>;
			pinctrl-14 = <&vow_clk_miso_off>;
			pinctrl-15 = <&vow_clk_miso_on>;
			pinctrl-16 = <&aud_gpio_i2s2_off>;
			pinctrl-17 = <&aud_gpio_i2s2_on>;
			pinctrl-18 = <&aud_gpio_i2s1_off>;
			pinctrl-19 = <&aud_gpio_i2s1_on>;
		};
	};

	fragment@20 {
		target = <&pio>;

		__overlay__ {

			aud_clk_mosi_off: aud_clk_mosi_off {
				phandle = <0x17>;

				pins_cmd0_dat {
					pinmux = <0xb200>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_clk_mosi_on: aud_clk_mosi_on {
				phandle = <0x18>;

				pins_cmd0_dat {
					pinmux = <0xb201>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_dat_mosi_off: aud_dat_mosi_off {
				phandle = <0x19>;

				pins_cmd1_dat {
					pinmux = <0xb400>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_dat_mosi_on: aud_dat_mosi_on {
				phandle = <0x1a>;

				pins_cmd1_dat {
					pinmux = <0xb401>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_dat_mosi_ch34_off: aud_dat_mosi_ch34_off {
				phandle = <0x1b>;

				pins_cmd1_dat {
					pinmux = <0xb500>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_dat_mosi_ch34_on: aud_dat_mosi_ch34_on {
				phandle = <0x1c>;

				pins_cmd1_dat {
					pinmux = <0xb501>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_dat_miso0_off: aud_dat_miso0_off {
				phandle = <0x1d>;

				pins_cmd1_dat {
					pinmux = <0xb900>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_dat_miso0_on: aud_dat_miso0_on {
				phandle = <0x1e>;

				pins_cmd1_dat {
					pinmux = <0xb901>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_dat_miso1_off: aud_dat_miso1_off {
				phandle = <0x1f>;

				pins_cmd2_dat {
					pinmux = <0xba00>;
					input-enable;
					bias-disable;
				};
			};

			aud_dat_miso1_on: aud_dat_miso1_on {
				phandle = <0x20>;

				pins_cmd2_dat {
					pinmux = <0xba01>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_dat_miso2_off: aud_dat_miso2_off {
				phandle = <0x21>;

				pins_cmd1_dat {
					pinmux = <0xbb00>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_dat_miso2_on: aud_dat_miso2_on {
				phandle = <0x22>;

				pins_cmd1_dat {
					pinmux = <0xbb01>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			vow_dat_miso_off: vow_dat_miso_off {
				phandle = <0x23>;

				pins_cmd1_dat {
					pinmux = <0xb900>;
					input-enable;
					bias-pull-down;
				};
			};

			vow_dat_miso_on: vow_dat_miso_on {
				phandle = <0x24>;

				pins_cmd1_dat {
					pinmux = <0xb902>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			vow_clk_miso_off: vow_clk_miso_off {
				phandle = <0x25>;

				pins_cmd3_dat {
					pinmux = <0xba00>;
					input-enable;
					bias-pull-down;
				};
			};

			vow_clk_miso_on: vow_clk_miso_on {
				phandle = <0x26>;

				pins_cmd1_dat {
					pinmux = <0xba02>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_nle_mosi_off: aud_nle_mosi_off {
				phandle = <0x7c>;

				pins_cmd1_dat {
					pinmux = <0xb700>;
					input-enable;
					bias-pull-down;
				};

				pins_cmd2_dat {
					pinmux = <0xb800>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_nle_mosi_on: aud_nle_mosi_on {
				phandle = <0x7d>;

				pins_cmd1_dat {
					pinmux = <0xb701>;
					input-schmitt-enable;
					bias-disable;
				};

				pins_cmd2_dat {
					pinmux = <0xb801>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_gpio_i2s2_off: aud_gpio_i2s2_off {
				phandle = <0x27>;

				pins_cmd1_dat {
					pinmux = <0x2700>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_gpio_i2s2_on: aud_gpio_i2s2_on {
				phandle = <0x28>;

				pins_cmd1_dat {
					pinmux = <0x2703>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_gpio_i2s1_off: aud_gpio_i2s1_off {
				phandle = <0x29>;

				pins_cmd1_dat {
					pinmux = <0x2400>;
					input-enable;
					bias-pull-down;
				};

				pins_cmd2_dat {
					pinmux = <0x2500>;
					input-enable;
					bias-pull-down;
				};

				pins_cmd3_dat {
					pinmux = <0x2600>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_gpio_i2s1_on: aud_gpio_i2s1_on {
				phandle = <0x2a>;

				pins_cmd1_dat {
					pinmux = <0x2401>;
					input-schmitt-enable;
					bias-disable;
				};

				pins_cmd2_dat {
					pinmux = <0x2501>;
					input-schmitt-enable;
					bias-disable;
				};

				pins_cmd3_dat {
