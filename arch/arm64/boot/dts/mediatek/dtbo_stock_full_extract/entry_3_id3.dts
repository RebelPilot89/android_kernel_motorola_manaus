				spi-max-frequency = <0x927c00>;
				goodix,reset-gpio = <&pio>, <0x9f 0x00>;
				goodix,irq-gpio = <&pio>, <0x16 0x2002>;
				goodix,avdd-gpio = <&pio>, <0xa7 0x00>;
				goodix,iovdd-name = "vtouch";
				vtouch-supply = <&mt6368_vtp>;
				goodix,irq-flags = <0x2002>;
				goodix,panel-max-id = <0x0a>;
				goodix,panel-max-x = <0x4380>;
				goodix,panel-max-y = <0x9600>;
				goodix,panel-max-w = <0x100>;
				goodix,panel-max-p = <0x100>;
				goodix,edge-ctrl;
				goodix,sample-ctrl;
				goodix,interpolation-ctrl;
				goodix,stowed-mode-ctrl;
				mmi,enable-gestures;
