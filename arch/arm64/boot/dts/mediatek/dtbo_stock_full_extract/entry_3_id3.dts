	fragment@53 {
		target = <&thermal_zones>;

		__overlay__ {

			chg_ntc: chg_ntc {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <&tboard_thermistor4>;
				phandle = <0x88>;
			};

			quiet_ntc: quiet_ntc {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <&tboard_thermistor5>;
				phandle = <0x89>;
			};

			tspk_ntc: tspk_ntc {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <&tboard_thermistor6>;
				phandle = <0x8a>;
			};
		};
	};

	fragment@54 {
		target = <&therm_intf>;

		__overlay__ {
			mmi,temperature-names = "BACK_TEMP", "FRONT_TEMP";
		};
	};

	fragment@55 {
		target = <&pio>;

		__overlay__ {

			vibrator_irq_input: vibrator_irq_input {
				phandle = <0x8b>;

				pins_cmd_dat {
					pinmux = <0x600>;
					slew-rate = <0x00>;
					input-enable;
					bias-pull-up;
				};
			};

			fingerfp_rst_high: fingerfp_rst_high {
				phandle = <0x46>;

				pins_cmd_dat {
					pinmux = <0x700>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			fingerfp_rst_low: fingerfp_rst_low {
				phandle = <0x47>;

				pins_cmd_dat {
					pinmux = <0x700>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			fingerfp_irq_active: fingerfp_irq_active {
				phandle = <0x48>;

				pins_cmd_dat {
					pinmux = <0x1800>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			fingerfp_spi_active: fingerfp_spi_active {
				phandle = <0x49>;

				pins_cmd_dat {
					pinmux = <0x4602 0x4402 0x4502 0x4302>;
					drive-strength = <0x02>;
				};
			};

			fingerfp_spi_default: fingerfp_spi_default {
				phandle = <0x4a>;

				pins_cmd_dat {
					pinmux = <0x4600 0x4400 0x4500 0x4300>;
					slew-rate = <0x01>;
					output-low;
				};
			};
		};
	};

	fragment@56 {
		target = <&u2port0>;

		__overlay__ {
			mediatek,eye-vrt = <0x04>;
