				focaltech,reset-gpio = <&pio>, <0x9f 0x00>;
				focaltech,irq-gpio = <&pio>, <0x16 0x2800>;
				focaltech,max-touch-number = <0x0a>;
				focaltech,display-coords = <0x00 0x00 0x4380 0x9600>;
				focaltech,panel-supplier = "csot";
				vcc_i2c-supply = <&mt6368_vtp>;
				focaltech,vdd-gpio = <&pio>, <0xa7 0x00>;
