			sar_int_default: sar_int_default {
				phandle = <0x2b>;

				pins_cmd_dat {
					pinmux = <0x7700>;
					input-enable;
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			sar_int_sleep: sar_int_sleep {
				phandle = <0x2c>;

				pins_cmd_dat {
					pinmux = <0x7700>;
					input-enable;
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};
		};
	};

