&i2c6 {
	spk: speaker_amp@5c {
		compatible = "richtek,rt5512";
		#sound-dai-cells = <0>;
		reg = <0 0x5c 0 0x1>;
		sound-name-prefix = "Left";
		status ="disable";
	};

	aw87xxx_pa@58 {
		compatible = "awinic,aw87xxx_pa";
		reg = <0 0x58 0 0x1>;

		dev_index = < 0 >;
		status = "okay";
	};

	aw87xxx_pa@59 {
		compatible = "awinic,aw87xxx_pa";
		reg = <0 0x59 0 0x1>;

		dev_index = < 1 >;
		status = "okay";
	};
};
